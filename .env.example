# Sem DATABASE_URL: PostgreSQL embarcado (PGlite) persistente, somente local.
DATABASE_URL=
PGLITE_DIR=.data/postgres
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
# Apenas seed local. Em produção defina credenciais próprias antes de executar o seed.
SEED_ADMIN_EMAIL=rh@example.com
SEED_ADMIN_PASSWORD=DemoRH!2026
# PostgreSQL gerenciado: use URL do pooler com SSL exigido pelo provedor.
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco?sslmode=require
