{
  "name": "trabalho-aluyzio-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API de compensação, custos e indicadores operacionais — Grupo 3",
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.js",
    "setup": "npm run db:migrate && npm run db:seed",
    "test": "node --test --test-concurrency=1",
    "demo": "node --env-file-if-exists=.env scripts/demo.js",
    "openapi": "node scripts/openapi.js",
    "check": "npm test && npm run openapi"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@node-rs/argon2": "^2.0.2",
    "decimal.js": "^10.6.0",
    "fastify": "^5.12.7",
    "pg": "^8.16.3"
  },
  "devDependencies": { "@apidevtools/swagger-parser": "^12.1.0" }
}
